{
  "name": "reelest-api",
  "version": "1.0.0",
  "private": true,
  "description": "Reelest API: auth, tenancy and media orchestration",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/studio/migrations','dist/studio/migrations',{recursive:true})\"",
    "studio:migrate": "tsx src/scripts/studio-migrate.ts",
    "moves:build": "tsx src/moves/build.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "storage:check": "tsx src/scripts/storage-check.ts",
    "secrets:rotate": "tsx src/scripts/rotate-secrets.ts",
    "worker": "tsx src/worker.ts",
    "redis": "node -e \"require('fs').mkdirSync('.redis-data',{recursive:true})\" && redis-server redis.local.conf",
    "render:check": "tsx src/scripts/render-check.ts",
    "storage:backfill": "tsx src/scripts/storage-backfill.ts",
    "marketing:slots": "tsx src/scripts/build-marketing-slots.ts"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "fflate": "0.8.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "geoip-lite": "1.4.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "ffmpeg-static",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
