# Product name (cookie names, Redis prefixes and JWT iss/aud derive from it)
APP_NAME=Veloai
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Neon: the -pooler URL for the app; migrations use the direct host
# (derived by dropping "-pooler", or set DIRECT_DATABASE_URL explicitly).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=
# Local Redis (docker compose up -d redis). Inside docker compose this is overridden to redis://redis:6379.
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
# Public web origin for emailed links and Paystack redirects (defaults to the first CORS origin)
WEB_APP_URL=http://localhost:3000

# Sessions. Generate each secret with: openssl rand -hex 48  (must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
COOKIE_DOMAIN=
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# Encrypts TOTP seeds, SMTP passwords, AI keys and the credential vault (required in production): openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# Only while rotating keys (pnpm secrets:rotate)
DATA_ENCRYPTION_KEY_PREVIOUS=

# Super admin, seeded on boot (must enrol 2FA at first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Subscription checkout provider. 'none' = plans assigned by the platform admin.
BILLING_PROVIDER=none

# Default SMTP account (shown as "Default (.env)" on the Mail page)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# Cloudflare R2: uploads, reels, studio films, likeness files, creations.
# The bucket needs a CORS rule allowing PUT/GET/HEAD from the web origin and exposing ETag.
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=
CF_R2_PUBLIC_URL=
# Upload relay (default true): browser uploads stream through this API into R2,
# so the bucket needs no CORS rule. Set false once the bucket CORS rule exists.
UPLOAD_RELAY=true
# Public URL of this API (used in upload links). Production: https://api.your-domain.com
API_PUBLIC_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Provider keys below can ALSO be entered (encrypted) in Console → Credentials;
# a value saved there overrides the one here, without a restart.
# ---------------------------------------------------------------------------

# Paystack: token purchases and storage packs. Test/live is switched in Console → Tokens & payments.
# Webhook URL to register in Paystack: https://<api-host>/api/v1/payments/paystack/webhook
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=

# Speech-to-text: any OpenAI-compatible /audio/transcriptions API with word timestamps.
# OpenAI:  TRANSCRIPTION_API_URL=https://api.openai.com/v1      TRANSCRIPTION_MODEL=whisper-1
# Groq:    TRANSCRIPTION_API_URL=https://api.groq.com/openai/v1 TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
# Optional: transcription fallback and a selectable hook model
OPENAI_API_KEY=

# Claude: reel hooks, the AI director, likeness analysis, prompt direction
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# fal.ai: images, video, lip sync, upscaling, likeness (@me) training
FAL_KEY=

# Media worker: inline in the API for local dev. In docker compose the worker
# service runs the jobs and the API gets MEDIA_WORKER_INLINE=false.
MEDIA_WORKER_INLINE=true
MEDIA_WORKER_CONCURRENCY=1

# AI director / AI capability name (user-facing)
BOT_NAME=VeloBot

# What users see for the video/audio models (provider and model names are never shown)
ENGINE_NAME=Velo film engine
